<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework/View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- On the results page, typing updates the whole page + facets live (instant
             search), so suppress the autocomplete dropdown here — it is only for other
             pages. -->
        <referenceBlock name="fastmagento.autocomplete.init" remove="true"/>
        <!-- The instant-search grid renders its own facet sidebar, so drop the native
             layered navigation to avoid a duplicate filter column. -->
        <referenceBlock name="catalog.leftnav" remove="true"/>
        <referenceBlock name="catalogsearch.leftnav" remove="true"/>
        <referenceContainer name="sidebar.main" remove="true"/>
        <referenceContainer name="content">
            <!-- Replace Magento's native search results with the OpenSearch instant-search
                 grid (facets + products + pagination rendered client-side from
                 /fastmagento/search/instant). -->
            <referenceBlock name="search.result" remove="true"/>
            <block class="Magento\Framework\View\Element\Template"
                   name="fastmagento.instant.search"
                   template="ParkkTech_FastMagento::search/instant.phtml"/>
        </referenceContainer>
    </body>
</page>
