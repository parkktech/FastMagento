<?php
/** @var \ParkkTech\FastMagento\Block\Search\Results $block */
$products = $block->getProducts();
?>

<div class="search-results">
    <h1>Search Results for "<?= $block->escapeHtml($block->getSearchQuery()); ?>"</h1>

    <?php if (!empty($products)): ?>
        <div class="products-grid">
            <?php foreach ($products as $product): ?>
                <div class="product-item">
                    <a href="<?= $block->escapeUrl($block->getProductUrl($product)) ?>">
                        <img src="<?= $block->escapeUrl($block->getProductImage($product)) ?>" alt="<?= $block->escapeHtml($product['name'] ?? '') ?>">
                        <h2><?= $block->escapeHtml($product['name'] ?? '') ?></h2>
                        <span class="price"><?= $block->escapeHtml($product['final_price'] ?? 'N/A') ?></span>
                    </a>
                </div>
            <?php endforeach; ?>
        </div>
    <?php else: ?>
        <p>No products found.</p>
    <?php endif; ?>
</div>
