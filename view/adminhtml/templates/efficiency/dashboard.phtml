                            <span class="fm-ctx <?= $block->escapeHtmlAttr(($f['context'] ?? 'guest') === 'logged_in' ? 'in' : 'guest') ?>"><?= $block->escapeHtml($block->contextLabel($f)) ?></span></td>
                        <td class="mono" title="<?= $block->escapeHtmlAttr($f['class'] . '::' . $f['method']) ?>"><?= $block->escapeHtml($block->shortClass($f['class'])) ?>::<b><?= $block->escapeHtml($f['method']) ?></b></td>
                        <td class="r"><span class="loops <?= $block->escapeHtmlAttr($sev) ?>">×<?= (int) $f['loops'] ?></span></td>
                        <td class="mono"><?= $block->escapeHtml($f['table']) ?></td>
                        <td class="r">
                            <form action="<?= $block->escapeUrl($block->getDismissUrl()) ?>" method="post" style="margin:0;">
                                <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
                                <input type="hidden" name="fm_key" value="<?= $block->escapeHtmlAttr($block->findingKey($f)) ?>">
                                <button type="submit" class="fm-clear" title="<?= $block->escapeHtmlAttr(__('Clear this hotspot')) ?>"><?= $block->escapeHtml(__('Clear')) ?></button>
                            </form>
                        </td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        <?php endif; ?>

        <!-- Module ranking -->
        <div class="sect-h"><h2><?= $block->escapeHtml(__('Extensions ranked by database overhead')) ?></h2></div>
        <div class="card" style="padding:4px 0;" role="table" aria-label="<?= $block->escapeHtmlAttr(__('Extensions ranked by database overhead')) ?>">
            <?php foreach ($block->getModules() as $module):
                $sc = $sevClass[$module['severity']] ?? 'good';
                $worstPerOp = (float) ($module['worst_per_op'] ?? 0);
            ?>
                <div class="mod" role="row">
                    <div class="mod-id">
                        <span class="dot <?= $block->escapeHtmlAttr($sc) ?>" aria-hidden="true"></span>
                        <div style="min-width:0;">
                            <div class="mod-name"><?= $block->escapeHtml($module['title']) ?>
                                <small><?= $block->escapeHtml($module['module']) ?></small></div>
                        </div>
                    </div>
                    <div>
                        <div class="mbar">
                            <div class="track"><div class="fill <?= $block->escapeHtmlAttr($sc) ?>"
                                style="width:<?= $block->barWidthPct($worstPerOp, $maxPerOp) ?>%;">
                                <?= $block->escapeHtml(number_format($worstPerOp, 1)) ?> q/op</div></div>
                        </div>
                        <div class="mdet">
                            <?php foreach (array_keys($module['per_op'] ?? []) as $area): ?>
                                <span class="chip"><?= $block->escapeHtml($block->areaLabel($area)) ?>: <?= $block->escapeHtml(number_format((float) $module['per_op'][$area], 1)) ?></span>
                            <?php endforeach; ?>
                            <?php foreach (($module['tables'] ?? []) as $t): ?>
                                <span class="chip mono"><?= $block->escapeHtml($t) ?></span>
                            <?php endforeach; ?>
                            <?php if (!empty($module['offenders'])): $off = $module['offenders'][0]; ?>
                                <span class="off"><?= $block->escapeHtml(__('Fires via')) ?>
                                    <b><?= $block->escapeHtml($block->shortSignature($off['signature'])) ?></b>
                                    <?= $block->escapeHtml(__('(×%1)', $off['count'])) ?></span>
                            <?php endif; ?>
                        </div>
                    </div>
                    <div class="mright" role="cell">
                        <span class="sev <?= $block->escapeHtmlAttr($sc) ?>"><?= $block->escapeHtml($block->severityLabel($module['severity'])) ?></span>
                        <div class="sub" style="font-size:12px;color:var(--mut);margin-top:6px;">
                            <?= $block->escapeHtml(__('%1 queries total', (int) $module['total'])) ?></div>
                    </div>
                </div>
            <?php endforeach; ?>
        </div>
        <div class="legend">
            <span><i style="background:var(--crit);"></i><?= $block->escapeHtml(__('High impact (≥5 q/op)')) ?></span>
            <span><i style="background:var(--warn);"></i><?= $block->escapeHtml(__('Moderate (≥1 q/op)')) ?></span>
            <span><i style="background:var(--good);"></i><?= $block->escapeHtml(__('Low impact')) ?></span>
        </div>

    <?php endif; ?>
</div>
