    <!--
      GLOBAL SCOPE:
      - Virtual types for your shell product
      - Indexer registry
      - Default definitions for ShellProduct, ShellPrice, etc.
      - ShellProductBuilder, etc.
   -->

    <!-- Virtual type for shell product (global) -->
<!--    <virtualType name="ParkkTech\FastMagento\Model\ShellProduct\VirtualShellProduct"
                 type="ParkkTech\FastMagento\Model\ShellProduct\ShellProduct">
        <arguments>
            <argument name="categoryCollectionFactory" xsi:type="object">
                Magento\Catalog\Model\ResourceModel\Category\CollectionFactory
            </argument>
        </arguments>
    </virtualType>-->

    <!-- Serve select/multiselect option labels from the OpenSearch dictionary (frontend only),
         removing the residual eav_attribute_option(_value) loads on served PDP attributes,
         layered-nav facets and swatches. Falls back to native on any miss. -->
    <type name="Magento\Eav\Model\Entity\Attribute\Source\Table">
        <plugin name="fastmagento_option_dictionary"
                type="ParkkTech\FastMagento\Plugin\Eav\SourceOptionPlugin" sortOrder="10"/>
    </type>

    <!--
        Product listing served from OpenSearch. See Model\Plp\ListingHydrator for why this is a
        hydration-only change: the id list, ordering, pagination and layered-nav counts already
        come from OpenSearch on a 2.4 install with a search engine configured.
    -->
    <!-- Hydration is a plugin on the core fulltext collection (see the end of this file), not a
         preference: a preference replaced the class, which broke any othe
nly swaps the base
        class. Both engines are covered because Magento_OpenSearch reuses the elasticsearch* names.
    -->
    <virtualType name="Magento\CatalogSearch\Model\ResourceModel\Fulltext\SearchCollection"
                 type="ParkkTech\FastMagento\Model\ResourceModel\Fulltext\Collection"/>

    <!-- Bundle up-sell: answer "is this product inside any bundle?" from the indexed
         fm_bundle_parents field instead of catalog_product_bundle_selection. -->
    <type name="Magento\Bundle\Model\ResourceModel\Selection">
        <plugin name="fastmagento_bundle_selection_parent_ids"
                type="ParkkTech\FastMagento\Plugin\Bundle\SelectionParentIdsPlugin"
                sortOrder="10"/>
    </type>
    <!-- Listing special-price badges: compute from the indexed price/final_price instead of the
         bulk price-index query. -->
    <type name="Magento\Catalog\Pricing\Price\SpecialPriceBulkResolverInterface">
        <plugin name="fastmagento_special_price_bulk"
                type="ParkkTech\FastMagento\Plugin\SpecialPriceBulkResolverPlugin"
                sortOrder="10"/>
    </type>
    <!-- Review count from the indexed reviews_count instead of a COUNT over review tables. -->
    <type name="Magento\Review\Block\Product\Review">
        <plugin name="fastmagento_review_collection_size"
                type="ParkkTech\FastMagento\Plugin\Review\ReviewCollectionSizePlugin" sortOrder="10"/>
    </type>
    <!-- Product-page review list (and its pager total, and every review's rating votes) from
         the review index in one search, instead of COUNT + SELECT + one vote query per review. -->
    <type name="Magento\Review\Model\ResourceModel\Review\Collection">
        <plugin name="fastmagento_review_list_from_index"
                type="ParkkTech\FastMagento\Plugin\Review\ReviewListFromIndexPlugin" sortOrder="10"/>
    </type>
    <!-- The review form's rating set from the cache (and once per request) instead of three
         queries per product page; invalidated on rating save/delete in etc/di.xml. -->
    <type name="Magento\Review\Block\Form">
        <plugin name="fastmagento_ratings_cache"
                type="ParkkTech\FastMagento\Plugin\Review\RatingsCachePlugin" sortOrder="10"/>
    </type>
    <!-- MSRP apply-to list via the cached EAV config instead of four attribute-load queries. -->
    <type name="Magento\Msrp\Model\Msrp">
        <plugin name="fastmagento_msrp_can_apply"
                type="ParkkTech\FastMagento\Plugin\Msrp\CanApplyToProductPlugin" sortOrder="10"/>
    </type>
    <!-- Captcha attempt count: once per request, not once per protected form. -->
    <type name="Magento\Captcha\Model\ResourceModel\Log">
        <plugin name="fastmagento_captcha_attempts_memo"
                type="ParkkTech\FastMagento\Plugin\Captcha\RemoteAttemptsMemoPlugin" sortOrder="10"/>
    </type>
    <!-- Category membership from the served document's category_ids. -->
    <type name="Magento\Catalog\Model\Product">
        <plugin name="fastmagento_can_be_show_in_category"
                type="ParkkTech\FastMagento\Plugin\CanBeShowInCategoryPlugin" sortOrder="10"/>
    </type>
    <!-- Category EAV attribute values from the index instead of the per-backend-type UNION.
         Scoped to categories inside the plugin; products and other EAV entities are untouched. -->
    <type name="Magento\Eav\Model\ResourceModel\ReadHandler">
        <plugin name="fastmagento_category_read_handler"
                type="ParkkTech\FastMagento\Plugin\Eav\CategoryReadHandlerPlugin" sortOrder="10"/>
    </type>
    <!-- A partially preconfigured configurable (one attribute chosen, another left to the shopper)
         makes core emit the unspecified attribute as null; drop those before the template. -->
    <type name="Magento\ConfigurableProduct\Model\ConfigurableAttributeData">
        <plugin name="parkktech_fastmagento_configurable_default_values"
                type="ParkkTech\FastMagento\Plugin\ConfigurableDefaultValuesPlugin"
                sortOrder="100"/>
    </type>

    <!-- Category model, breadcrumb walk and design walk from the category index (storefront). -->
    <type name="Magento\Catalog\Model\CategoryRepository">
        <plugin name="fastmagento_category_repository_from_index"
                type="ParkkTech\FastMagento\Plugin\CategoryRepositoryFromIndexPlugin" sortOrder="5"/>
    </type>
    <type name="Magento\Catalog\Model\Category">
        <plugin name="fastmagento_category_parents_from_index"
                type="ParkkTech\FastMagento\Plugin\CategoryParentsFromIndexPlugin" sortOrder="5"/>
    </type>
    <!-- Filterable-attribute list for the layer from the cache (covers the search subclass). -->
    <type name="Magento\Catalog\Model\Layer\Category\FilterableAttributeList">
        <plugin name="fastmagento_filterable_attributes_cache"
                type="ParkkTech\FastMagento\Plugin\Layer\FilterableAttributeListCachePlugin" sortOrder="10"/>
    </type>
    <!-- Swatch definitions from the attribute-option dictionary. -->
    <type name="Magento\Swatches\Helper\Data">
        <plugin name="fastmagento_swatches_from_index"
                type="ParkkTech\FastMagento\Plugin\Swatches\SwatchesFromIndexPlugin" sortOrder="10"/>
    </type>
    <!-- Category widget / slider collections (CMS widgets, Hyvä ProductList) served from the indexes:
         ids from Magento's own search index, products from the FastMagento documents. -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="fastmagento_widget_collection_from_index"
                type="ParkkTech\FastMagento\Plugin\WidgetProductCollectionPlugin" sortOrder="20"/>
    </type>
    <!-- Intercept entity hydration before any SQL load, on whatever collection class is actually
         resolved (core, a third-party subclass, or a virtual type). Replaces the former preference. -->
    <type name="Magento\CatalogSearch\Model\ResourceModel\Fulltext\Collection">
        <plugin name="fastmagento_collection_entity_hydration"
                type="ParkkTech\FastMagento\Plugin\CollectionEntityHydration" sortOrder="5"/>
    </type>
    <!-- Fill an empty configurable image configuration from the indexed child documents so a
         theme block that returns no images does not fall back to a swatch AJAX round-trip. -->
    <type name="Magento\ConfigurableProduct\Block\Product\View\Type\Configurable">
        <plugin name="fastmagento_inline_configurable_images"
                type="ParkkTech\FastMagento\Plugin\ConfigurableImagesPlugin" sortOrder="100"/>
    </type>
</config>
