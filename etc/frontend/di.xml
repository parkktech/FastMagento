    </type>-->

    <!-- ShellDataProduct -->
<!--    <type name="ParkkTech\FastMagento\Model\ShellProduct\ShellDataProduct">
        <arguments>
            <argument name="urlModel" xsi:type="object">Magento\Catalog\Model\Product\Url</argument>
        </arguments>
