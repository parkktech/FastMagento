<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
       FRONTEND SCOPE:
       - We only want to override \Magento\Catalog\Model\Product with our Shell plugin
         on the front end (not in admin).
       - We also override the front-end product view controller.
    -->



    <!-- ✅ Ensure backend/indexer uses MySQL resource collection -->
<!--    <preference for="Magento\Catalog\Model\ResourceModel\Product\Collection"
                    type="ParkkTech\FastMagento\Model\ResourceModel\Product\IndexerProductCollection">
        <scope>frontend</scope>
    </preference>-->

    <!-- ✅ Plugin: Use OpenSearch Collection for Product Listings (PLP, Search, etc.) -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\CollectionFactory">
        <plugin name="frontend_product_collection_plugin"
                type="ParkkTech\FastMagento\Plugin\FrontendProductCollectionPlugin"
                sortOrder="10"/>
    </type>

    <!-- ✅ Plugin: Serve Related / Up-sell / Cross-sell (product-link) collections from OpenSearch -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Link\Product\Collection">
        <plugin name="fastmagento_link_product_collection"
                type="ParkkTech\FastMagento\Plugin\LinkProductCollectionPlugin"
                sortOrder="10"/>
    </type>

    <!-- ✅ Plugin: Use OpenSearch for Individual Product Retrieval (PDP, Cart, Checkout) -->
    <type name="Magento\Catalog\Model\Product">
        <plugin name="frontend_product_plugin"
                type="ParkkTech\FastMagento\Plugin\FrontendProductPlugin"
                sortOrder="10"/>
    </type>

    <!-- ✅ Override TierPrice Only on Frontend -->
    <preference for="Magento\Catalog\Pricing\Price\TierPrice"
                type="ParkkTech\FastMagento\Pricing\Price\TierPrice" />

    <!-- ✅ Override CatalogRulePrice Only on Frontend -->
    <preference for="Magento\CatalogRule\Pricing\Price\CatalogRulePrice"
                type="ParkkTech\FastMagento\Pricing\Price\CatalogRulePrice" />

    <!-- ✅ Override SpecialPrice on the frontend so a shell's special_price=0 (no special
         price) is treated as "none" instead of a $0 special that zeroes out FinalPrice. -->
    <preference for="Magento\Catalog\Pricing\Price\SpecialPrice"
                type="ParkkTech\FastMagento\Pricing\Price\SpecialPrice" />

    <!-- ✅ Serve the configurable price resolver from OpenSearch child shells (carrying
         indexed catalog-rule + tier price) instead of a native child collection. Kills the
         per-child catalogrule_product_price + catalog_product_entity_tier_price N+1 on the
         configurable PDP price path. -->
    <type name="Magento\ConfigurableProduct\Pricing\Price\LowestPriceOptionsProvider">
        <plugin name="fastmagento_lowest_price_options"
                type="ParkkTech\FastMagento\Plugin\LowestPriceOptionsProviderPlugin"
                sortOrder="10"/>
    </type>

    <!-- ✅ Override Configurable::getParentIdsByChild() Only on Frontend -->
    <preference for="Magento\ConfigurableProduct\Model\ResourceModel\Product\Type\Configurable"
                type="ParkkTech\FastMagento\Model\Configurable\ConfigurableProductType" />
    <!-- ParentIdResolver injected as a Proxy: ProductIndexer depends on this resource model
         (ConfigurableResource), so a direct injection would form a construction cycle. -->
    <type name="ParkkTech\FastMagento\Model\Configurable\ConfigurableProductType">
        <arguments>
            <argument name="parentIdResolver" xsi:type="object">ParkkTech\FastMagento\Model\OpenSearch\ParentIdResolver\Proxy</argument>
        </arguments>
    </type>

    <!-- Serve Grouped::getParentIdsByChild() from OpenSearch too (product sliders call it
         per product alongside the configurable one). Shares ParentIdResolver's cache. -->
    <type name="Magento\GroupedProduct\Model\Product\Type\Grouped">
        <plugin name="fastmagento_grouped_parent_ids"
                type="ParkkTech\FastMagento\Plugin\GroupedParentIdPlugin"
                sortOrder="10"/>
    </type>

    <!-- Frontend-only: collapse the per-category url_rewrite N+1 (mega-menu / breadcrumbs /
         category tree each call $category->getUrl()) into one batched query per store. -->
    <type name="Magento\UrlRewrite\Model\UrlFinderInterface">
        <plugin name="fastmagento_category_url_finder"
                type="ParkkTech\FastMagento\Plugin\CategoryUrlFinderPlugin"
                sortOrder="10"/>
    </type>

    <!-- Frontend-only: serve category collection attribute values (name/url_key/is_active/
         include_in_menu/is_anchor/all_children) from OpenSearch, skipping the native
         catalog_category_entity_* UNION loads. Covers mega-menu, top-nav, breadcrumb
         parents and layered-nav children; falls back to native on any unservable attr/item. -->
    <type name="Magento\Catalog\Model\ResourceModel\Category\Collection">
        <plugin name="fastmagento_category_attribute_load"
                type="ParkkTech\FastMagento\Plugin\CategoryAttributeLoadPlugin"
                sortOrder="10"/>
    </type>

    <!-- Frontend-only: drop deleted/disabled/hidden products from the bestsellers report so
         storefront widgets never surface unshoppable products. Admin reports keep every row
         (this plugin is scoped to the frontend area). -->
    <type name="Magento\Sales\Model\ResourceModel\Report\Bestsellers\Collection">
        <plugin name="fastmagento_bestsellers_frontend_filter"
                type="ParkkTech\FastMagento\Plugin\BestsellersFrontendFilterPlugin"
                sortOrder="10"/>
    </type>

    <!-- ✅ Override Magento’s Configurable Product Type -->
    <preference for="Magento\ConfigurableProduct\Model\Product\Type\Configurable"
                type="ParkkTech\FastMagento\Model\Product\Type\Configurable" />

    <!-- Disable core's used-products cache on the frontend. It serializes each child's
         getData() and, on cache HIT, rebuilds children as NATIVE Product objects
         (productFactory->create()->setData()) — stripping the OS shell type AND the doc's
         indexed catalog_rule_price/tier_prices. Those native children then resolve their
         catalog-rule + tier price from MySQL, one query each: the ~660-pair N+1 that
         reappears on every cached configurable price render (isTierPriceApplicable /
         hasSpecialPrice iterate getUsedProducts). Our getUsedProducts already serves the
         children as shells from the per-request registry (no DB), so this cache is both
         redundant and harmful. -->
    <type name="Magento\ConfigurableProduct\Model\Product\Type\Configurable">
        <plugin name="used_products_cache" disabled="true"/>
    </type>

    <!-- ✅ Use OpenSearch for StockRegistry on the frontend -->
  <preference for="Magento\CatalogInventory\Api\StockRegistryInterface"
                type="ParkkTech\FastMagento\Model\OpenSearchStockRegistry" />

    <!-- Keep a composite parent (configurable/grouped/bundle) sellable at the cart stock gate
         when OpenSearch (its children) says it is, correcting a stale native/MSI parent
         salability that otherwise makes QuantityValidator reject add-to-cart with "This product
         is out of stock." sortOrder 100 runs this AFTER MSI's AdaptGetStockStatusPlugin (no
         sortOrder = PHP_INT_MIN) so it has the final say. See the plugin class for safety notes
         (only lifts the coarse parent gate; the purchased child is still validated natively). -->
    <type name="Magento\CatalogInventory\Api\StockRegistryInterface">
        <plugin name="fastmagento_composite_parent_stock_status"
                type="ParkkTech\FastMagento\Plugin\Inventory\CompositeParentStockStatusPlugin"
                sortOrder="100"/>
    </type>



    <!-- Disabled: conflicted with frontend_product_plugin (both aroundLoad on
         Product at sortOrder 10) and returned a bare product without the OpenSearch
         fetch. FrontendProductPlugin is the single load choke point. -->
    <type name="Magento\Catalog\Model\Product">
        <plugin name="shell_product_override"
                type="ParkkTech\FastMagento\Plugin\ShellProductPlugin"
                sortOrder="10" disabled="true"/>
    </type>

    <type name="Magento\Catalog\Api\ProductRepositoryInterface">
        <plugin name="shell_product_override" type="ParkkTech\FastMagento\Plugin\ProductRepositoryPlugin" sortOrder="10" disabled="false"/>
    </type>

    <preference for="Magento\ConfigurableProduct\Model\ResourceModel\Product\Type\Configurable\Attribute\Collection"
                type="ParkkTech\FastMagento\Model\ResourceModel\Product\Type\Configurable\Attribute\Collection"/>
    <type name="Magento\Catalog\Model\Product">
        <plugin name="catalogInventoryAfterLoad" disabled="true"/>
    </type>

    <type name="Magento\Checkout\Model\Cart">
        <plugin name="fastmagento_set_custom_price" type="ParkkTech\FastMagento\Plugin\Checkout\AddProductPlugin" />
    </type>
    <type name="Magento\Quote\Model\Quote\Item">
        <plugin name="inject_price_on_get_product" type="ParkkTech\FastMagento\Plugin\Quote\QuoteItemPlugin" />
    </type>

