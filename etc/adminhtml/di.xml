<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!--
       ADMINHTML SCOPE:
       If you want to ensure the Product Collection for Admin / Indexer uses MySQL,
       you can define that preference here.
    -->

    <!-- ✅ Ensure backend/indexer uses MySQL resource collection -->
<!--    <preference for="Magento\Catalog\Model\ResourceModel\Product\Collection"
                type="ParkkTech\FastMagento\Model\ResourceModel\Product\IndexerProductCollection"
    />-->

    <!-- Safety net: when attribute pagination is on, prevent the native attribute Save from
         processing the (unrendered) monolithic option payload, so it can never wipe the option
         set. Options are managed per-row via the paginated manager's AJAX endpoints. -->
    <type name="Magento\Catalog\Controller\Adminhtml\Product\Attribute\Save">
        <plugin name="fastmagento_attribute_option_save_guard"
                type="ParkkTech\FastMagento\Plugin\Adminhtml\AttributeSaveOptionGuardPlugin"/>
    </type>
</config>
