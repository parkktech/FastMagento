<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework/Config/etc/system_file.xsd">

    <system>
        <!-- Define Tab -->
        <tab id="fastmagento" translate="label">
            <label>FastMagento</label>
        </tab>

        <!-- FastMagento Section -->
        <section id="fastmagento" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>FastMagento Settings</label>
            <tab>fastmagento</tab>
            <resource>ParkkTech_FastMagento::config</resource>

            <!-- Indexing Configuration -->
            <group id="indexing" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Indexing Configuration</label>

                <field id="enable_realtime_indexing" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Real-Time Indexing</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="enable_cron_indexing" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Cron-Based Indexing</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <!-- ✅ New Setting: OpenSearch Index Prefix -->
                <field id="opensearch_index_prefix" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Index Suffix</label>
                    <comment>Suffix for the FastMagento product index (&lt;engine prefix&gt;_&lt;suffix&gt;). Default "products".</comment>
                </field>

                <field id="opensearch_category_index_prefix" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Category Index Suffix</label>
                    <comment>Suffix for the FastMagento category index. Default "categories".</comment>
                </field>
            </group>

            <!-- Instant Search + Relevance -->
            <group id="search" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Instant Search &amp; Relevance</label>

                <field id="searchable_attributes" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Searchable Attributes &amp; Weights</label>
                    <frontend_model>ParkkTech\FastMagento\Block\Adminhtml\System\Config\SearchableAttributes</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                    <comment>Attributes searched, ranked by weight (higher = stronger). One place to control what Magento otherwise hides in each attribute's Search Weight. Leave empty to use the built-in defaults (name, sku, description).</comment>
                </field>

                <field id="typo_tolerance" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Typo Tolerance</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Fuzzy matching so misspellings still find results (like Algolia typo tolerance).</comment>
                </field>

                <field id="boost_in_stock" translate="label comment" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Boost In-Stock Products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Rank in-stock products above out-of-stock ones (a custom-ranking tie-breaker).</comment>
                </field>

                <field id="custom_ranking_attribute" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Ranking Attribute</label>
                    <comment>Optional numeric attribute used as a secondary ranking signal after text relevance (e.g. bestseller position, rating). Blank = relevance only.</comment>
                </field>

                <field id="custom_ranking_direction" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Ranking Direction</label>
                    <source_model>ParkkTech\FastMagento\Model\Config\Source\RankingDirection</source_model>
                </field>

                <field id="synonyms" translate="label comment" type="textarea" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Synonyms / Thesaurus</label>
                    <comment><![CDATA[One equivalence group per line, comma-separated (e.g. <em>bra, brassiere, bralette</em>). A search for any term also matches the others. Pre-populated with common defaults; edit freely.]]></comment>
                </field>

                <field id="stopwords" translate="label comment" type="textarea" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Stop Words</label>
                    <comment>Comma- or space-separated words ignored in queries (e.g. the, a, for, with). Pre-populated with common English stop words.</comment>
                </field>

                <field id="facet_attributes" translate="label comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Facet Attributes</label>
                    <comment>Comma-separated attribute codes to build search facets from (e.g. part_type,compatible_platforms). Must be filterable in the native search index. Category is always included.</comment>
                </field>
            </group>

            <!-- AI Assistant (Claude) -->
            <group id="ai" translate="label" sortOrder="25" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>AI Assistant (Claude)</label>
                <comment><![CDATA[Connect a Claude API key to auto-generate a search thesaurus from your own catalogue. Get a key at <a href="https://console.anthropic.com/" target="_blank">console.anthropic.com</a>.]]></comment>

                <field id="claude_api_key" translate="label comment" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Claude API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Stored encrypted. Used only for the generator below; leave blank to disable AI features.</comment>
                </field>

                <field id="claude_model" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Model</label>
                    <comment>Claude model id. Default claude-opus-4-8.</comment>
                </field>

                <field id="max_terms" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Max Catalogue Terms</label>
                    <comment>Upper bound on attribute values + category names sent to the model (keeps large catalogues bounded). Default 1200.</comment>
                </field>

                <field id="generate_thesaurus" translate="label comment" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Generate Thesaurus</label>
                    <frontend_model>ParkkTech\FastMagento\Block\Adminhtml\System\Config\GenerateThesaurusButton</frontend_model>
                    <comment>Reads your attribute values + categories and builds shopper-facing synonym groups, merged into Search &gt; Synonyms above. Save the API Key first. Review and Save the Synonyms field afterward.</comment>
                </field>
            </group>

            <!-- Cache Optimization -->
            <group id="cache" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cache Optimization</label>

                <field id="popular_searches" translate="label" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Popular Search Terms (Comma-Separated)</label>
                </field>
            </group>
        </section>
    </system>
</config>
