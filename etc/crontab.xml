<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework/App/etc/crontab.xsd">

    <group id="default">

        <!-- Existing Cron Job (Keep this) -->
        <job name="fastmagento_existing_cron" instance="ParkkTech\FastMagento\Cron\ExistingCronJob" method="execute">
            <schedule>*/30 * * * *</schedule> <!-- Runs every 30 minutes -->
        </job>

        <!-- New Cache Warmup Job (Merge this with existing jobs) -->
        <job name="fastmagento_cache_warmup" instance="ParkkTech\FastMagento\Cron\CacheWarmup" method="execute">
            <schedule>0 * * * *</schedule> <!-- Runs every hour -->
        </job>

        <!-- Extension-efficiency scan. Schedule comes from config (fastmagento/efficiency/cron_expr);
             the job no-ops unless fastmagento/efficiency/cron_enabled is on. -->
        <job name="fastmagento_efficiency_scan" instance="ParkkTech\FastMagento\Cron\EfficiencyScan" method="execute">
            <config_path>fastmagento/efficiency/cron_expr</config_path>
        </job>

    </group>

</config>
