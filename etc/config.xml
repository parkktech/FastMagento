<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <fastmagento>
            <indexing>
                <opensearch_index_prefix>products</opensearch_index_prefix>
                <opensearch_category_index_prefix>categories</opensearch_category_index_prefix>
            </indexing>
            <search>
                <!-- Attribute facets shown on the instant search results page (comma-separated
                     attribute codes). SELECT-type filterable attributes only: their option
                     labels resolve cleanly from OpenSearch. Multi-select attributes are not
                     included here — their id→label pairing can't be resolved from the native
                     index alone (see InstantSearch::bucketLabel) and needs an indexed option
                     dictionary (follow-up). Admin-overridable under FastMagento > Search. -->
                <facet_attributes>part_type,color,size,link_style,shock_spacing</facet_attributes>
                <typo_tolerance>1</typo_tolerance>
                <boost_in_stock>1</boost_in_stock>
                <custom_ranking_direction>desc</custom_ranking_direction>
                <!-- How multiple query terms combine: any (OR, minimum_should_match:1 — today's
                     behaviour), all (AND — every term must match), most (minimum_should_match:75%).
                     Default any to preserve behaviour; switch to all/most to tighten precision. -->
                <search_operator>any</search_operator>
                <!-- Exact/phrase match boost: a product whose name/keywords contain the query as a
                     contiguous phrase outranks scattered-token hits. 0 disables. -->
                <phrase_match_boost>4</phrase_match_boost>
                <!-- AI keyword layer (fm_search_keywords). Populated OFF the request path by
                     bin/magento fastmagento:search-keywords:generate. Default OFF: no commit
                     changes live search until a store enables it AND runs the generator. -->
                <search_keywords_enabled>0</search_keywords_enabled>
                <search_keywords_weight>8</search_keywords_weight>
                <!-- Attribute codes whose labels give the AI product context when generating
                     keywords. Blank falls back to the facet attributes above. -->
                <keyword_source_attributes/>
                <stopwords>a, an, and, or, the, of, for, with, to, in, on, at, by, is, it, this, that, your, my</stopwords>
                <!-- Global synonym groups. Keep terms DISTINCTIVE: a group term that is a common
                     catalogue word (e.g. "side" inside "side by side") over-broadens every query
                     that expands to it, because synonym equivalents are matched at full strength.
                     Put buyer PHRASES that contain common words (e.g. "side by side" -> UTV) in the
                     per-product AI keyword layer (fm_search_keywords) instead, where they match
                     precisely. That's why "sxs, utv" lives here but "side by side" does not. -->
                <synonyms>frontend, front end
sxs, utv
atv, quad, four wheeler, 4 wheeler, four-wheeler
a-arm, a arm, control arm, control-arm
sway bar, anti-roll bar, stabilizer bar, swaybar
light bar, led bar, light-bar
skid plate, belly pan, skid-plate, skidplate
tie rod, tierod, tie-rod
rod end, heim, heim joint, heim-joint
radius rod, radius arm, trailing arm
can-am, canam, can am
rzr, razor
prerunner, pre-runner, pre runner
bumper, bull bar, brush guard
bra, brassiere, bralette
helmet, lid, moto helmet
tire, tyre, tires, tyres
aluminum, aluminium, alu
color, colour
gray, grey, charcoal, slate
merlot, burgundy, wine, maroon, bordeaux
navy, dark blue
blush, rose
ivory, cream, off white
lavender, purple, violet
mount, bracket, tab
bolt, screw, fastener
shock, damper, coilover
teal, aqua, turquoise
beige, tan, khaki, sand
olive, army green
silver, metallic, gunmetal
tee, t-shirt, tshirt
hoodie, hoody, sweatshirt
pants, trousers, bottoms
sneakers, trainers, tennis shoes
jacket, coat
leather, genuine leather
xs, extra small, x-small
s, sm, small
m, medium, med
l, large, lg
xl, extra large, x-large
xxl, 2xl, double xl
xxxl, 3xl, triple xl</synonyms>
            </search>
            <ai>
                <claude_model>claude-opus-4-8</claude_model>
                <max_terms>1200</max_terms>
            </ai>
            <!-- Admin attribute-option pagination. Default ON: replaces Magento's native
                 "Manage Options"/swatch grid (which loads and re-saves the WHOLE option set and
                 crashes past a few thousand options) with a paginated, per-row-CRUD manager. -->
            <attribute_pagination>
                <enabled>1</enabled>
                <page_size>50</page_size>
            </attribute_pagination>
            <cart>
                <!-- Master toggle. Default ON. Turning it on enables the WHOLE fast pipeline —
                     OS-serving the quote items, optimistic stock, AND fast stock sync — so Fast
                     Checkout works fully out of the box. Safe by default: any product
                     missing/partial in the index falls back to the native path, and order
                     placement still gates stock by SKU (cannot oversell). Set to 0 to disable the
                     whole bundle. The individual (advanced) toggles below stay 0 by design: the
                     master implies them, and each can still force its feature on by itself when
                     the master is off (that OR is why they must default 0 — otherwise turning the
                     master off would not disable them). -->
                <enable_fast_checkout>1</enable_fast_checkout>
                <!-- Advanced override (default 0). Implied ON by the master above. OS-serves the
                     quote-item collection (checkout code). Set 1 to force on while the master is off. -->
                <os_serve_quote_items>0</os_serve_quote_items>
                <!-- Advanced override (default 0). Implied ON by the master above. Optimistic
                     stock — skip the redundant per-load MSI stock preload and rely on the
                     placement-time CheckItemsQuantity gate. Set 1 to force on while master is off. -->
                <optimistic_stock>0</optimistic_stock>
                <!-- Advanced override (default 0). Implied ON by the master above. Fast stock
                     sync — when an order/refund/inventory save mutates stock, patch just the stock
                     fields of the affected OpenSearch docs (mget → patch is_in_stock/qty +
                     composite child stock → bulk re-index) instead of a full EAV reprojection.
                     Falls back to a full reproject for any doc missing/partial in the index.
                     Background (post-response) work. Set 1 to force on while the master is off. -->
                <fast_stock_sync>0</fast_stock_sync>
                <!-- Line-item name for configurable products on cart/mini-cart/checkout:
                     parent = the configurable name (Magento default), child = the purchased
                     simple's name. Default parent = no change. -->
                <configurable_line_name>parent</configurable_line_name>
            </cart>
        </fastmagento>
    </default>
</config>
