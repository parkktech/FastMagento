<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Register ProductIndexer in the indexer registry (used in all scopes) -->
    <type name="Magento\Framework\Indexer\IndexerRegistry">
        <arguments>
            <argument name="indexers" xsi:type="array">
                <item name="fastmagento_product_indexer" xsi:type="object">ParkkTech\FastMagento\Model\Indexer\ProductIndexer</item>
            </argument>
        </arguments>
    </type>

    <type name="ParkkTech\FastMagento\Helper\WriteLog">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface\Proxy</argument>
        </arguments>
    </type>

    <!-- CLI: AI search-keyword layer generation (fastmagento:search-keywords:generate) and
         thesaurus/synonym generation (fastmagento:thesaurus:generate). -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="fastmagento_generate_search_keywords" xsi:type="object">ParkkTech\FastMagento\Console\Command\GenerateSearchKeywords</item>
                <item name="fastmagento_generate_thesaurus" xsi:type="object">ParkkTech\FastMagento\Console\Command\GenerateThesaurus</item>
                <item name="fastmagento_efficiency_scan" xsi:type="object">ParkkTech\FastMagento\Console\Command\EfficiencyScan</item>
                <item name="fastmagento_efficiency_worker" xsi:type="object">ParkkTech\FastMagento\Console\Command\EfficiencyWorker</item>
                <item name="fastmagento_doctor" xsi:type="object">ParkkTech\FastMagento\Console\Command\Doctor</item>
                <item name="fastmagento_synonyms_import" xsi:type="object">ParkkTech\FastMagento\Console\Command\ImportSynonyms</item>
            </argument>
        </arguments>
    </type>

    <!-- Efficiency monitor: the search scenario needs the real fulltext search collection. Its
         factory is a virtualType (can't be a PHP constructor hint), so bind it here; the second
         collection-factory argument keeps the plain product collection for the PLP scenario. -->
    <type name="ParkkTech\FastMagento\Model\Efficiency\ScenarioRunner">
        <arguments>
            <argument name="fulltextCollectionFactory" xsi:type="object">Magento\CatalogSearch\Model\ResourceModel\Fulltext\CollectionFactory</argument>
        </arguments>
    </type>

    <!-- Real-time OpenSearch stock sync when MSI stock is written via the inventory API
         (admin grid, imports, ERP/integration, bin/magento inventory:*). -->
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="fastmagento_source_items_save_sync"
                type="ParkkTech\FastMagento\Plugin\Inventory\SourceItemsSyncPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsDeleteInterface">
        <plugin name="fastmagento_source_items_delete_sync"
                type="ParkkTech\FastMagento\Plugin\Inventory\SourceItemsSyncPlugin"
                sortOrder="100"/>
    </type>

    <!-- Keep the OpenSearch index's catalog-rule prices live: after Magento recomputes
         catalogrule_product_price (rule save, per-product, or the nightly apply-all), patch the
         affected OS docs' catalog_rule_prices map straight away so the OS-served cart is always
         correct without a manual reindex. Best-effort; falls back to a full reproject on any
         miss. See CatalogRuleSyncer. -->
    <type name="Magento\CatalogRule\Model\Indexer\IndexBuilder">
        <plugin name="fastmagento_rule_price_sync"
                type="ParkkTech\FastMagento\Plugin\CatalogRule\RulePriceSyncPlugin"
                sortOrder="100"/>
    </type>

    <!-- OS-serve the quote-item product load (cart/checkout). GLOBAL so it's active for the
         customer-facing checkout REST/GraphQL calls too, not just the frontend cart page — the
         area is gated inside the class (isServableArea: frontend/webapi_rest/graphql; adminhtml
         + cron stay native). Overrides ONLY _assignProducts(); flag-gated (default 0) with a
         hard native fallback for any missing/partial doc, composite/custom-option cart, or
         non-servable area. See the class for the full safety contract. -->
    <preference for="Magento\Quote\Model\ResourceModel\Quote\Item\Collection"
                type="ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\Collection" />

    <!-- Optimistic-stock: skip the per-qty-set MSI stock revalidation (QuantityValidator) on
         the customer-facing quote path — the single biggest query source on a physical-product
         cart. Placement's CheckItemsQuantity stays the authoritative gate. Both flags + servable
         area gated in-plugin (adminhtml/cron keep full validation). Default off. -->
    <type name="Magento\CatalogInventory\Observer\QuantityValidatorObserver">
        <plugin name="fastmagento_optimistic_skip_qty_validator"
                type="ParkkTech\FastMagento\Plugin\Inventory\QuantityValidatorSkipPlugin"
                sortOrder="10"/>
    </type>

    <!-- Optimistic-stock: also suspend the marketplace per-line stock observer (it re-loads +
         re-saves the stock item on every qty-set, cascading into MSI source-item syncs — the
         bulk of a physical/configurable cart's query load). Same flags + servable-area gate;
         placement's CheckItemsQuantity stays the authoritative gate. Default off. -->
    <type name="Jadog\Marketplacechanges\Observer\QuantityValidatorObserver">
        <plugin name="fastmagento_optimistic_skip_marketplace_qty"
                type="ParkkTech\FastMagento\Plugin\Inventory\OptimisticObserverSkipPlugin"
                sortOrder="10"/>
    </type>

    <!-- Re-prime FastMagento caches in the process that flushed them, so the first storefront
         request after a deploy or an admin cache flush does not pay the rebuild. -->
    <type name="Magento\Framework\App\Cache\Manager">
        <plugin name="fastmagento_cache_flush_hydration"
                type="ParkkTech\FastMagento\Plugin\CacheFlushHydrationPlugin"
                sortOrder="100"/>
    </type>
    <!-- Cart existence check via OpenSearch.
         core's removeItemsWithAbsentProducts() builds a product collection through the PROTECTED
         _productCollectionFactory and calls getAllIds() only to spot deleted products. A virtual
         type keeps the factory's class (so the constructor type hint is satisfied) while changing
         which collection it builds, so core's control flow is untouched and only the lookup moves. -->
    <virtualType name="ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\AbsentCheckProductCollectionFactory"
                 type="Magento\Catalog\Model\ResourceModel\Product\CollectionFactory">
        <arguments>
            <argument name="instanceName" xsi:type="string">ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\AbsentCheckProductCollection</argument>
        </arguments>
    </virtualType>
    <type name="ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\Collection">
        <arguments>
            <argument name="productCollectionFactory" xsi:type="object">ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\AbsentCheckProductCollectionFactory</argument>
            <!-- Appended after core's optional parameters to keep positions; DI does not
                 auto-resolve optional parameters, so they are declared here. -->
            <argument name="osFetcher" xsi:type="object">ParkkTech\FastMagento\Helper\OpenSearchPdpFetcher</argument>
            <argument name="osShellBuilder" xsi:type="object">ParkkTech\FastMagento\Helper\ShellProductBuilder</argument>
            <argument name="osAppState" xsi:type="object">Magento\Framework\App\State</argument>
            <argument name="osScopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</argument>
            <argument name="osQuoteModelConfig" xsi:type="object">Magento\Quote\Model\Config</argument>
        </arguments>
    </type>
    <!-- fastmagento:doctor extension point. Core ships no providers; other modules add
         CheckProviderInterface implementations to this array. -->
    <type name="ParkkTech\FastMagento\Model\Doctor\Diagnostics">
        <arguments>
            <argument name="checkProviders" xsi:type="array"/>
        </arguments>
    </type>
    <!-- Search-stack seams. Core's defaults do nothing; a companion module may override each
         preference with its own implementation. -->
    <preference for="ParkkTech\FastMagento\Model\Search\QueryDecoratorInterface"
                type="ParkkTech\FastMagento\Model\Search\NullQueryDecorator"/>
    <preference for="ParkkTech\FastMagento\Model\Search\ExplorationWindowInterface"
                type="ParkkTech\FastMagento\Model\Search\NullExplorationWindow"/>
    <preference for="ParkkTech\FastMagento\Model\Analytics\EventRecorderInterface"
                type="ParkkTech\FastMagento\Model\Analytics\NullEventRecorder"/>
    <!-- Drop the cached review-form rating set when a rating or option changes (RatingsCachePlugin). -->
    <type name="Magento\Review\Model\ResourceModel\Rating">
        <plugin name="fastmagento_ratings_cache_invalidate"
                type="ParkkTech\FastMagento\Plugin\Review\RatingsCacheInvalidationPlugin" sortOrder="10"/>
    </type>
    <type name="Magento\Review\Model\ResourceModel\Rating\Option">
        <plugin name="fastmagento_ratings_cache_invalidate_option"
                type="ParkkTech\FastMagento\Plugin\Review\RatingsCacheInvalidationPlugin" sortOrder="10"/>
    </type>
    <type name="ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\AbsentCheckProductCollection">
        <plugin name="fastmagento_absent_check_from_index"
                type="ParkkTech\FastMagento\Plugin\Quote\AbsentCheckFromIndexPlugin" sortOrder="10"/>
    </type>
    <type name="ParkkTech\FastMagento\Model\ShellProduct\ShellNoEavProduct">
        <arguments>
            <!-- Appended after core Product's $data so its position is unchanged; declared here
                 because DI does not auto-resolve optional parameters. -->
            <argument name="urlFinder" xsi:type="object">Magento\UrlRewrite\Model\UrlFinderInterface</argument>
            <argument name="categoryCollectionFactory" xsi:type="object">Magento\Catalog\Model\ResourceModel\Category\CollectionFactory</argument>
            <argument name="scopeConfig" xsi:type="object">Magento\Framework\App\Config\ScopeConfigInterface</argument>
            <argument name="customerGroupSession" xsi:type="object">Magento\Customer\Model\Session</argument>
        </arguments>
    </type>
    <!-- Adobe Commerce: relationship-table changelog rows carry row_id; translate them to the
         public entity id. No-op on Open Source (EntityLink reports entity_id). -->
    <type name="Magento\Framework\Mview\View\Subscription">
        <plugin name="fastmagento_relationship_entity_id" type="ParkkTech\FastMagento\Plugin\Mview\RelationshipEntityId"/>
    </type>
    <!-- Optional Commerce hooks: the plugin classes depend only on IndexerRegistry, and a plugin
         declared on a class that is not installed is ignored, so Open Source is unaffected. -->
    <type name="Magento\CatalogStaging\Model\ProductApplier">
        <plugin name="fastmagento_product_staging_reindex" type="ParkkTech\FastMagento\Plugin\Staging\ProductReindex"/>
    </type>
    <type name="Magento\CatalogStaging\Model\CategoryApplier">
        <plugin name="fastmagento_category_staging_reindex" type="ParkkTech\FastMagento\Plugin\Staging\CategoryReindex"/>
    </type>
</config>
