<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- ✅ Register ProductIndexer in the indexer registry (used in all scopes) -->
    <type name="Magento\Framework\Indexer\IndexerRegistry">
        <arguments>
            <argument name="indexers" xsi:type="array">
                <item name="fastmagento_product_indexer" xsi:type="object">ParkkTech\FastMagento\Model\Indexer\ProductIndexer</item>
            </argument>
        </arguments>
    </type>

    <type name="ParkkTech\FastMagento\Helper\WriteLog">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface\Proxy</argument>
        </arguments>
    </type>

    <!-- CLI: AI search-keyword layer generation (fastmagento:search-keywords:generate). -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="fastmagento_generate_search_keywords" xsi:type="object">ParkkTech\FastMagento\Console\Command\GenerateSearchKeywords</item>
            </argument>
        </arguments>
    </type>

    <!-- Real-time OpenSearch stock sync when MSI stock is written via the inventory API
         (admin grid, imports, ERP/integration, bin/magento inventory:*). -->
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="fastmagento_source_items_save_sync"
                type="ParkkTech\FastMagento\Plugin\Inventory\SourceItemsSyncPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsDeleteInterface">
        <plugin name="fastmagento_source_items_delete_sync"
                type="ParkkTech\FastMagento\Plugin\Inventory\SourceItemsSyncPlugin"
                sortOrder="100"/>
    </type>

    <!-- Keep the OpenSearch index's catalog-rule prices live: after Magento recomputes
         catalogrule_product_price (rule save, per-product, or the nightly apply-all), patch the
         affected OS docs' catalog_rule_prices map straight away so the OS-served cart is always
         correct without a manual reindex. Best-effort; falls back to a full reproject on any
         miss. See CatalogRuleSyncer. -->
    <type name="Magento\CatalogRule\Model\Indexer\IndexBuilder">
        <plugin name="fastmagento_rule_price_sync"
                type="ParkkTech\FastMagento\Plugin\CatalogRule\RulePriceSyncPlugin"
                sortOrder="100"/>
    </type>

    <!-- OS-serve the quote-item product load (cart/checkout). GLOBAL so it's active for the
         customer-facing checkout REST/GraphQL calls too, not just the frontend cart page — the
         area is gated inside the class (isServableArea: frontend/webapi_rest/graphql; adminhtml
         + cron stay native). Overrides ONLY _assignProducts(); flag-gated (default 0) with a
         hard native fallback for any missing/partial doc, composite/custom-option cart, or
         non-servable area. See the class for the full safety contract. -->
    <preference for="Magento\Quote\Model\ResourceModel\Quote\Item\Collection"
                type="ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\Collection" />

    <!-- Optimistic-stock: skip the per-qty-set MSI stock revalidation (QuantityValidator) on
         the customer-facing quote path — the single biggest query source on a physical-product
         cart. Placement's CheckItemsQuantity stays the authoritative gate. Both flags + servable
         area gated in-plugin (adminhtml/cron keep full validation). Default off. -->
    <type name="Magento\CatalogInventory\Observer\QuantityValidatorObserver">
        <plugin name="fastmagento_optimistic_skip_qty_validator"
                type="ParkkTech\FastMagento\Plugin\Inventory\QuantityValidatorSkipPlugin"
                sortOrder="10"/>
    </type>

    <!-- Optimistic-stock: also suspend the marketplace per-line stock observer (it re-loads +
         re-saves the stock item on every qty-set, cascading into MSI source-item syncs — the
         bulk of a physical/configurable cart's query load). Same flags + servable-area gate;
         placement's CheckItemsQuantity stays the authoritative gate. Default off. -->
    <type name="Jadog\Marketplacechanges\Observer\QuantityValidatorObserver">
        <plugin name="fastmagento_optimistic_skip_marketplace_qty"
                type="ParkkTech\FastMagento\Plugin\Inventory\OptimisticObserverSkipPlugin"
                sortOrder="10"/>
    </type>

</config>
