<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- ✅ Register ProductIndexer in the indexer registry (used in all scopes) -->
    <type name="Magento\Framework\Indexer\IndexerRegistry">
        <arguments>
            <argument name="indexers" xsi:type="array">
                <item name="fastmagento_product_indexer" xsi:type="object">ParkkTech\FastMagento\Model\Indexer\ProductIndexer</item>
            </argument>
        </arguments>
    </type>

    <type name="ParkkTech\FastMagento\Helper\WriteLog">
        <arguments>
            <argument name="logger" xsi:type="object">Psr\Log\LoggerInterface\Proxy</argument>
        </arguments>
    </type>

    <!-- Real-time OpenSearch stock sync when MSI stock is written via the inventory API
         (admin grid, imports, ERP/integration, bin/magento inventory:*). -->
    <type name="Magento\InventoryApi\Api\SourceItemsSaveInterface">
        <plugin name="fastmagento_source_items_save_sync"
                type="ParkkTech\FastMagento\Plugin\Inventory\SourceItemsSyncPlugin"
                sortOrder="100"/>
    </type>
    <type name="Magento\InventoryApi\Api\SourceItemsDeleteInterface">
        <plugin name="fastmagento_source_items_delete_sync"
                type="ParkkTech\FastMagento\Plugin\Inventory\SourceItemsSyncPlugin"
                sortOrder="100"/>
    </type>

    <!-- OS-serve the quote-item product load (cart/checkout). GLOBAL so it's active for the
         customer-facing checkout REST/GraphQL calls too, not just the frontend cart page — the
         area is gated inside the class (isServableArea: frontend/webapi_rest/graphql; adminhtml
         + cron stay native). Overrides ONLY _assignProducts(); flag-gated (default 0) with a
         hard native fallback for any missing/partial doc, composite/custom-option cart, or
         non-servable area. See the class for the full safety contract. -->
    <preference for="Magento\Quote\Model\ResourceModel\Quote\Item\Collection"
                type="ParkkTech\FastMagento\Model\ResourceModel\Quote\Item\Collection" />

</config>
